{
  // ===========================================================================
  //  Ajustes del proyecto slither_2d para VS Code  (Linux / Kali)
  //  Este archivo va al repo, así que vale igual en todas tus máquinas Linux.
  // ===========================================================================

  // ---------------------------------------------------------------------------
  //  1) Ejecutable de Godot 4.7
  //     Si hiciste el symlink de COMO_TRABAJAR.md (§1.3), esto funciona tal cual.
  //     Si prefieres no usar sudo, pon la ruta completa, por ejemplo:
  //       "/home/kilombero/Godot/Godot_v4.7.2-stable_linux.x86_64"
  //     Importante: la extensión ejecuta el binario y comprueba la versión, así
  //     que tiene que ser Godot 4.x (el proyecto usa 4.7). Si no, VS Code te
  //     pedirá que elijas otro ejecutable.
  //     NOTA: no sirve escribir "godot" a secas, hace falta ruta absoluta.
  // ---------------------------------------------------------------------------
  "godotTools.editorPath.godot4": "/usr/local/bin/godot",

  // ---------------------------------------------------------------------------
  //  2) Servidor de lenguaje (autocompletado, errores, ir a definición)
  // ---------------------------------------------------------------------------
  // headless = true  -> la extensión arranca su propio Godot sin ventana; NO
  //                     hace falta tener el editor de Godot abierto.
  // headless = false -> se conecta al editor de Godot que tengas abierto
  //                     (más funciones, pero el editor debe estar abierto
  //                     antes de abrir VS Code; si no, pulsa "Retry").
  "godotTools.lsp.headless": true,
  "godotTools.lsp.serverHost": "127.0.0.1",
  "godotTools.lsp.serverPort": 6005,
  "godotTools.lsp.autoReconnect.enabled": true,

  // ---------------------------------------------------------------------------
  //  3) GDScript: tabuladores, como exige el lenguaje
  //     (mezclar espacios y tabuladores es la causa nº1 de errores de parseo)
  // ---------------------------------------------------------------------------
  "[gdscript]": {
    "editor.insertSpaces": false,
    "editor.detectIndentation": false,
    "editor.tabSize": 4,
    "editor.trimAutoWhitespace": false
  },

  // ---------------------------------------------------------------------------
  //  4) Carpeta .godot/: es la caché de importación. No se sube al repo, no hace
  //     falta verla y, en Linux, excluirla del vigilante de archivos evita
  //     agotar el límite de inotify (Godot crea muchísimos archivos ahí).
  // ---------------------------------------------------------------------------
  "files.exclude": {
    "**/.godot": true
  },
  "search.exclude": {
    "**/.godot": true
  },
  "files.watcherExclude": {
    "**/.godot/**": true
  },

  // Guardar siempre en UTF-8 y con salto de línea LF, como pide el .gitattributes
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.trimTrailingWhitespace": false,

  // La terminal integrada abre donde está el proyecto
  "terminal.integrated.cwd": "${workspaceFolder}"
}
